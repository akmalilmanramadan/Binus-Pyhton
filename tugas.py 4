# no5
def konversi_nilai(huruf):
    if huruf == "A":
        return 4.00
    elif huruf == "A-":
        return 3.75
    elif huruf == "B+":
        return 3.50
    elif huruf == "B":
        return 3.00
    elif huruf == "B-":
        return 2.75
    elif huruf == "C+":
        return 2.50
    elif huruf == "C":
        return 2.00
    elif huruf == "C-":
        return 1.75
    elif huruf == "D":
        return 1.50
    elif huruf == "E":
        return 1.20
    else:
        return 0

total = 0
jumlah = int(input("Enter number of subjects: "))

i = 1
while i <= jumlah:
    grade = input(f"Enter grade for subject {i}: ").upper()
    total += konversi_nilai(grade)
    i += 1

rata_rata = total / jumlah
print("Average Grade:", round(rata_rata, 2))
